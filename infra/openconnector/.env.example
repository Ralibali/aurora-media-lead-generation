# Public HTTPS origin behind your reverse proxy. Do not expose the console over plain HTTP.
OOMOL_CONNECT_ORIGIN=https://connect.example.se

# Generate each independently, e.g. openssl rand -base64 32.
# Never commit real values.
OOMOL_CONNECT_ENCRYPTION_KEY=replace-me
OOMOL_CONNECT_ADMIN_TOKEN=replace-me
OOMOL_CONNECT_RUNTIME_TOKEN=replace-me

# Deployment-level policy is a second guardrail in addition to Aurora's per-connection allowlist.
# Start narrow and expand only after a reviewed workflow needs another action.
OOMOL_CONNECT_ALLOWED_ACTIONS=github.get_current_user
OOMOL_CONNECT_BLOCKED_ACTIONS=
OOMOL_CONNECT_ALLOWED_PROXIES=github
OOMOL_CONNECT_BLOCKED_PROXIES=
